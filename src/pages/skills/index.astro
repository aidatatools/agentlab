---
import MainLayout from '../../layouts/MainLayout.astro';
const skills=[['x-research','Find and verify relevant source posts'],['github-discovery','Inspect public Python & TypeScript repos'],['arxiv-research','Read papers and assess research status'],['fact-check','Verify claims against original sources'],['code-review','Classify provenance and verify snippets'],['article-writing','Create editorial stories'],['image-curation','Check image origin, rights, and alt text'],['youtube-publishing','Prepare a video release; approval required'],['site-publishing','Open PRs and confirm site checks']];
---
<MainLayout title="Skills"><section class="wrap page-intro"><div class="kicker">Inspectable agent capabilities</div><h1>Skills library</h1><p class="lead">Executable skill instructions live in the GitHub repository. A skill only counts as used when its execution is recorded in a real mission.</p></section><section class="wrap section grid">{skills.map(([name,desc])=><div class="panel"><span class="tag">SKILL.md</span><h3>{name}</h3><p>{desc}</p></div>)}</section></MainLayout>
