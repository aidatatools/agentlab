---
import MainLayout from '../../layouts/MainLayout.astro';import {getCollection} from 'astro:content';import {getVerifiedSkillUse} from '../../lib/site';const agents=await getCollection('agents');const use=await getVerifiedSkillUse();
const verified=(id:string)=>[...use].filter(([,runs])=>runs.some(r=>r.agentId===id)).map(([skill])=>skill);
---
<MainLayout title="Agents"><section class="wrap page-intro"><div class="kicker">Agent-agnostic system</div><h1>Agents</h1><p class="lead">Multiple orchestration environments can submit mission records using the same contract. Declared capabilities are configuration; only verified skills are backed by recorded mission executions.</p></section><section class="wrap section grid grid-2">{agents.map(a=>{const skills=verified(a.data.id);return <div class="panel"><span class="tag">{a.data.enabled?'Enabled':'Disabled'}</span><h2>{a.data.displayName}</h2><p>Framework: {a.data.framework}</p><h3>Verified skills</h3>{skills.length?<p>{skills.map(s=><span class="tag">{s}</span>)}</p>:<p class="muted">None recorded in a real mission yet.</p>}<h3>Declared capabilities</h3>{a.data.capabilities.length?<p>{a.data.capabilities.map(s=><span class="tag">{s}</span>)}</p>:<p class="muted">None declared.</p>}<h3>Human approval required</h3><p>{a.data.requireApproval.join(' · ')}</p></div>})}</section></MainLayout>
