---
import MainLayout from '../../layouts/MainLayout.astro';import {getCollection} from 'astro:content';const agents=await getCollection('agents');
---
<MainLayout title="Agents"><section class="wrap page-intro"><div class="kicker">Agent-agnostic system</div><h1>Agents</h1><p class="lead">Multiple orchestration environments can submit mission records using the same contract. Capabilities below are configured examples, not live provider guarantees.</p></section><section class="wrap section grid grid-2">{agents.map(a=><div class="panel"><span class="tag">{a.data.enabled?'Configured':'Disabled'}</span><h2>{a.data.displayName}</h2><p>Framework: {a.data.framework}</p><h3>Declared capabilities</h3><p>{a.data.capabilities.map(s=><span class="tag">{s}</span>)}</p><h3>Human approval required</h3><p>{a.data.requireApproval.join(' · ')}</p></div>)}</section></MainLayout>
