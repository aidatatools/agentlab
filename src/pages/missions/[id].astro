---
import {getCollection} from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
export async function getStaticPaths(){const missions=await getCollection('missions');return missions.map(m=>({params:{id:m.data.missionId},props:{mission:m}}));}
const {mission}=Astro.props;const m=mission.data;
---
<MainLayout title={`Mission ${m.date}`}><section class="wrap page-intro"><a class="crumb" href="/missions/">← All missions</a><div class="kicker">{m.missionId}</div><h1>Execution trace</h1><p class="lead">{m.objective.goal}</p><span class="tag">{m.status}</span><span class="tag">{m.agent.id}</span><span class="tag">{m.date}</span>{m.status==='demo'&&<div class="warning">DEMONSTRATION ONLY. This is an illustrative record, not a real successful agent run.</div>}</section>
<section class="wrap section grid grid-2"><div class="panel"><h3>Mission objective</h3><p>{m.objective.goal}</p><div class="smallrow"><span>Candidate count</span><b>{m.selection.candidatesEvaluated}</b></div><div class="smallrow"><span>Chosen candidate</span><b>{m.selection.selectedCandidateId??'None'}</b></div><div class="smallrow"><span>Article state</span><b>{m.outcome.publicationStatus}</b></div><div class="smallrow"><span>Framework</span><b>{m.agent.framework}</b></div></div><div class="panel"><h3>Skills used</h3>{m.skillsUsed.length?m.skillsUsed.map(s=><div class="smallrow"><span>{s.skill} / {s.version}</span><b>{s.status}</b></div>):<p>No skills executed yet.</p>}<h3>Tests</h3>{m.tests.map(t=><div class="smallrow"><span>{t.name}</span><b>{t.status}</b></div>)}</div></section>
<section class="wrap section grid grid-2"><div class="panel"><h3>Execution timeline</h3>{m.timeline.length?<ol class="timeline">{m.timeline.map(s=><li><strong>{s.action}</strong><div class="muted">{s.tool} · {s.status}</div></li>)}</ol>:<p>Awaiting a real agent run.</p>}</div><div class="panel"><h3>Evidence</h3>{m.evidence.length?m.evidence.map(e=><div class="smallrow"><span>{e.type}</span><code>{e.ref}</code></div>):<p>No evidence published yet.</p>}<h3>Retrospective</h3><p>{m.retrospective.lessonsLearned.join(' ')||'Pending'}</p><div class="smallrow"><span>Human interventions</span><b>{m.metrics.humanInterventions}</b></div><div class="smallrow"><span>Cost</span><b>{m.metrics.estimatedCostUsd===null?'Not available':`US$${m.metrics.estimatedCostUsd}`}</b></div></div></section></MainLayout>
