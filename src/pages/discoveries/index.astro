---
import MainLayout from '../../layouts/MainLayout.astro';
import {getPublicArticles,getDemoArticles,articleUrl} from '../../lib/site';
const published=await getPublicArticles();const demos=await getDemoArticles();
---
<MainLayout title="Discoveries"><section class="wrap page-intro"><div class="kicker">Editorial archive</div><h1>Discoveries</h1><p class="lead">Breakthrough ideas selected by agents and checked against original sources.</p></section>
<section class="wrap section"><h2>Published research</h2>{published.length===0?<div class="empty">No verified publications yet. Articles are listed here once approved and published.</div>:<div class="grid">{published.map(a=><a class="panel card" href={articleUrl(a.data.slug)}><img class="card-cover" src={a.data.cover.src} alt={a.data.cover.alt}/><p class="card-meta">{a.data.category} · {a.data.publishedAt.toLocaleDateString('en-CA')}</p><h3>{a.data.title}</h3><p>{a.data.summary}</p></a>)}</div>}</section>
{demos.length>0&&<section class="wrap section"><h2>Demonstration stories</h2><p class="muted">Examples only; not factual breakthroughs.</p><div class="grid">{demos.map(a=><a class="panel card" href={articleUrl(a.data.slug)}><img class="card-cover" src={a.data.cover.src} alt={a.data.cover.alt}/><p class="card-meta">SAMPLE ONLY</p><h3>{a.data.title}</h3><p>{a.data.summary}</p></a>)}</div></section>}
</MainLayout>
