# Agent runners ONLY. Never commit .env or export these into Astro's public client bundle.
GITHUB_REPOSITORY=YOUR_ORG/agentlab-aidatatools
GITHUB_TOKEN=                    # fine-grained token or GitHub App installation token
X_API_TOKEN=                     # optional; requires appropriate X API access
YOUTUBE_CLIENT_ID=               # Phase 2 (OAuth; requires approval)
YOUTUBE_CLIENT_SECRET=           # Phase 2
# Do not place API tokens in PUBLIC_* variables.
